{
  "name": "reguverse-learn-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create reguverse-learn",
    "db:init": "wrangler d1 execute reguverse-learn --remote --file=schema.sql",
    "db:seed": "wrangler d1 execute reguverse-learn --remote --file=seed/ue-course.sql",
    "db:init:local": "wrangler d1 execute reguverse-learn --local --file=schema.sql",
    "db:seed:local": "wrangler d1 execute reguverse-learn --local --file=seed/ue-course.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
